<?xml version="1.0" encoding="utf-8"?>
<!-- Kirakira Basket's adaptive launcher icon (WP2, docs/DESIGN_STICKER.md §20.3 item 49): the pinstripe binder, the
     picnic hamper with three strawberries and a holo star inside the 66 dp safe zone, and a ballpoint monochrome layer
     for themed icons. No letters. The layers are generated from the sticker DSL (design/stickers/launcher.py). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/sk_l_launcher_background" />
    <foreground android:drawable="@drawable/sk_l_launcher_foreground" />
    <monochrome android:drawable="@drawable/sk_l_launcher_monochrome" />
</adaptive-icon>
