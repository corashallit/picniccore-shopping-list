<?xml version="1.0" encoding="utf-8"?>
<!--
    Resource-shrinker keep rule (WP10, docs/DESIGN_STICKER.md §14): platform/Feedback.kt looks WP2's sound clips
    (res/raw/sk_*.wav) up by name, so the release build must keep them. The shrinker reads this file and leaves it
    out of the APK.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:keep="@raw/sk_*" />
