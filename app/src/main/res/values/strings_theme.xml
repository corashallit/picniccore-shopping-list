<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme-layer strings: WP4 (tokens, components, accessibility of theme pieces; docs/DESIGN_STICKER.md §21). -->

    <plurals name="theme_aisle_header">
        <item quantity="one">%1$s, %2$d item</item>
        <item quantity="other">%1$s, %2$d items</item>
    </plurals>
    <!-- Aisle header: "<aisle>, <still to get> to get, <already gotten> in the basket". -->
    <string name="theme_aisle_header_progress">%1$s, %2$d to get, %3$d in the basket</string>
    <string name="theme_state_collapsed">collapsed</string>
    <string name="theme_state_expanded">expanded</string>
    <string name="theme_aisle_cleared">All picked up!</string>
