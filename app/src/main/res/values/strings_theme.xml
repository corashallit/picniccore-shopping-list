    <string name="theme_trip_progress">%1$d of %2$d in the basket</string>
    <string name="theme_switch_on">On</string>
    <string name="theme_switch_off">Off</string>

    <!-- LCD chip (§13.1): TalkBack reads the count whatever the LCD shows; the receipt action exists only after the
         trip is complete, with Easter eggs on. -->
    <plurals name="theme_lcd_count">
        <item quantity="one">%1$d of %2$d in the basket</item>
        <item quantity="other">%1$d of %2$d in the basket</item>
    </plurals>
    <string name="theme_lcd_print_receipt">Print the trip receipt</string>

    <!-- App bar (§4.2). The sun is an egg, not a feature: no hint. -->
    <string name="theme_more_options">More options</string>
    <string name="theme_sun_sticker">Sun sticker</string>
    <string name="theme_moon_sticker">Moon sticker</string>

    <!-- Chips (§4.7). -->
    <string name="theme_store_aisle">store aisle %1$d</string>
    <string name="theme_chip_shiny">shiny!</string>
    <string name="theme_chip_jackpot">jackpot!</string>

    <!-- Key field (§4.8). -->
    <string name="theme_key_show">Show key</string>
    <string name="theme_key_hide">Hide key</string>
    <string name="theme_key_paste">Paste key</string>

    <!-- Toast action (§4.15). -->

    <!-- Empty state art (§4.21): the doodle (hearts are drawn, not typed) and the sheet's printed caption. -->
    <string name="theme_empty_doodle">let\'s go shopping</string>
    <string name="theme_empty_sheet_caption">sticker sheet 1 of 2</string>

    <!-- Loaders under reduced motion (§4.22). -->
    <string name="theme_loader_working">working…</string>
