# Picnic List proxy on the system's Node, without Docker (docs/PROXY.md §4).
#
#   sudo install -m 0644 /opt/picnic-proxy/proxy/deploy/picnic-proxy.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now picnic-proxy
#   systemctl status picnic-proxy; journalctl -u picnic-proxy -f
#
# Assumes the checkout at /opt/picnic-proxy (owned by root) and Node 22+ at /usr/bin/node (NodeSource or a
# distro package; Debian 12 and Ubuntu 24.04 ship older versions). Adjust WorkingDirectory= and ExecStart=
# otherwise; a node installed under /home (nvm) is hidden by ProtectHome=.
#
# Secrets live in /etc/picnic-proxy/picnic-proxy.env (root:root, 0600). systemd reads it as root before
# starting the service, so the service's own throwaway user never has access to the file itself.

[Unit]
Description=Picnic List proxy (OpenAI passthrough for Picnic List devices)
Documentation=https://github.com/corashallit/picniccore-shopping-list/blob/main/docs/PROXY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
WorkingDirectory=/opt/picnic-proxy/proxy
ExecStart=/usr/bin/node scripts/server.mjs
EnvironmentFile=/etc/picnic-proxy/picnic-proxy.env
# Loopback only: Caddy or nginx terminates TLS in front of it. (Values in the env file override these.)
Environment=NODE_ENV=production HOST=127.0.0.1 PORT=8787
SyslogIdentifier=picnic-proxy

Restart=on-failure
RestartSec=5s
# Exit 78 means a broken configuration (the journal lists the problems): fix the env file, don't loop.
RestartPreventExitStatus=78
# SIGTERM drains in-flight requests for up to SHUTDOWN_GRACE_SECONDS (120 s); then systemd waits 10 s more.
TimeoutStopSec=130s

# Resources
MemoryMax=256M
MemorySwapMax=0
TasksMax=64

# Identity: a transient unprivileged user that exists only while the service runs.
DynamicUser=yes
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

# Filesystem: everything read-only, no /home, private /tmp and /dev. The proxy writes nothing.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectProc=invisible

# Kernel and host
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
# IP for clients and OpenAI; AF_UNIX and AF_NETLINK for the C library's DNS and address lookups.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
# MemoryDenyWriteExecute= stays off: V8's JIT compiler needs writable, executable memory.

[Install]
WantedBy=multi-user.target
